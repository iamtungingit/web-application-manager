<?xml version="1.0" encoding="utf-8"?>
<!-- Problem 1 (user): "make the widgets hold 1 app space and stop with that tall
     crap" — the widget renders as ONE app icon (adaptive-icon look, drawn at the
     density-scaled cell size by WidgetRenderer). No label/subtitle stack below the
     icon anymore: one widget = one app, occupying a single launcher app space.
     The root stays transparent so the launcher cell padding shows through. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</FrameLayout>
