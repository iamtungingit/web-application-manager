<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is app-wide (Android restriction, spec §3.5). Per-WAP network policy
         is enforced inside WAM: WebSettings.setBlockNetworkLoads, request interception,
         Content-Security-Policy headers and navigation restrictions.
         CAMERA / RECORD_AUDIO (v1.5.0): runtime-gated per WAP — an app only reaches
         them when the user enables it in Apps → long-press → App settings AND approves
         the Android prompt at request time. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".app.WamApp"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.WAM">

        <!-- Launcher + .wap import (VIEW/SEND). Content from Intents is untrusted (spec §3.11). -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="application/x-wap" />
                <data android:scheme="content" android:mimeType="application/zip" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/x-wap" />
                <data android:scheme="file" android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-wap" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <!-- Non-exported (D5). Lives in WAM's own task: launching a WAP never creates a
             new Recents entry (launchMode singleTop + onNewIntent reuses the instance).
             configChanges keeps rotation from destroying sessions (spec §10.3). -->
        <activity
            android:name=".ui.runtime.RuntimeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Per-app permission settings (v1.5.0 user request #7). -->
        <activity
            android:name=".ui.settings.AppSettingsActivity"
            android:exported="false"
            android:label="@string/app_settings_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- In-app documentation: plain Views only, opens even when the WebView
             engine itself is broken (that is one of the things it explains). -->
        <activity
            android:name=".ui.help.HelpActivity"
            android:exported="false"
            android:label="@string/guide_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Technical exception D4: required by the framework for android:configure. -->
        <activity
            android:name=".ui.widget.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.WAM.Dialog"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <receiver
            android:name=".widget.WapWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wap_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
