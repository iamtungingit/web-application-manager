<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_title"
        app:navigationIcon="@drawable/ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Defaults -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sec_defaults"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_default_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_default_fullscreen" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_keep_screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_keep_screen_on" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_confirm_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_confirm_exit" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_default_orientation"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spin_orientation"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- Network -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_network"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_network_default"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spin_network"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_per_app_network"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_per_app_network" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_cleartext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_cleartext" />

        <!-- Runtime & preview -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_webview"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_preview_engine"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spin_preview_engine"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/lbl_text_zoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_text_zoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="50"
            android:valueTo="200"
            android:stepSize="10" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_force_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_force_dark" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_safe_browsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_safe_browsing" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_webview_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_webview_debug" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_direct_zip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_direct_zip" />

        <!-- Appearance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_appearance"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_theme"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spin_theme"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_layout"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spin_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- Storage -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_storage"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <TextView
            android:id="@+id/txt_size_installed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_size_appdata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_size_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_size_projects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_size_cache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_per_app_data"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/per_app_data_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clean_temp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/set_clean_temp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_cache"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/set_clear_cache" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/storage_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Developer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_dev"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_dev_console"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_dev_console" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_dev_warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_dev_warnings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_log_level"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/spin_log_level"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show_sessions"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_show_sessions" />

        <!-- Official JS API (v1.6.0 user request #3): what apps can call and where
             the reference lives. Replaces the old documentation pointer line. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_js_api"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_js_api_summary"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_js_api"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_open_js_api"
            app:icon="@drawable/ic_code" />

        <!-- Compatibility -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_compat"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <TextView
            android:id="@+id/txt_runtime_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_manifest_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_webview_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_feature_bridge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_feature_docstart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- About (v1.5.0 user request #6): full app/about card with author,
             GitHub link and an update check against GitHub releases. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sec_about"
            android:textAppearance="@style/TextAppearance.WAM.SectionHeader" />

        <TextView
            android:id="@+id/txt_about_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/txt_about_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/txt_about_github"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/wam_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_check_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_check_update"
            app:icon="@drawable/ic_retry" />

        <TextView
            android:id="@+id/txt_update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="32dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
