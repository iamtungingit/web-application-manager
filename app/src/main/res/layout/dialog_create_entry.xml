<?xml version="1.0" encoding="utf-8"?>
<!-- Create dialog (v1.5.0 user request #8.1): ONE create button with a file name
     input, a type selector (html / css / js / folder / other) and an extension
     input that appears when "Other" is selected. Live name validation mirrors the
     project-name dialog: warnings appear WHILE typing. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ce_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/create_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ce_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textNoSuggestions"
                android:maxLength="255" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/ce_name_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/create_name_rules"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- "Other" extension input (user: "when you select other another input
             appears on top called extension where you can type it like .php
             .htaccess .ts") — shown above the type selector. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ce_ext_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/create_ext_hint"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ce_ext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textNoSuggestions"
                android:maxLength="64" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/create_type_label"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Spinner
            android:id="@+id/ce_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />
    </LinearLayout>
</ScrollView>
